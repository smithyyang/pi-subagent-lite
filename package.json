{
  "name": "pi-subagent-lite",
  "version": "0.1.1",
  "description": "Lightweight subagent for Pi — async, concurrent, file-based results",
  "author": "smithyyang",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node --input-type=module -e \"await import('./src/index.ts')\"",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithyyang/pi-subagent-lite.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagent",
    "delegation"
  ],
  "files": [
    "src/**/*.ts",
    "agents/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
